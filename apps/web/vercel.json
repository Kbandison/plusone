{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then exit 1; fi; npx turbo-ignore --fallback=HEAD^1",
  "regions": ["pdx1"],
  "crons": [
    {
      "path": "/api/cron/fuse-sweep",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/drop-notify",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/connect-sweep",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/purge",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/referral-rewards",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/fuse-warning",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/news",
      "schedule": "40 */6 * * *"
    },
    {
      "path": "/api/cron/premium-expiry",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/nearby-joins",
      "schedule": "0 17 * * 3"
    },
    {
      "path": "/api/cron/activity-nearby",
      "schedule": "10 * * * *"
    }
  ]
}
