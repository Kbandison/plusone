# Gradle's own output. Regenerated by `pnpm aab`, and large.
build/
app/build/
.gradle/

# The build artefacts themselves, which land beside this file rather than under
# build/. A committed .aab is a megabyte of binary that is stale the moment the
# site deploys — and it is SIGNED, so it is also a thing somebody could install
# believing it current.
*.aab
*.apk
*.idsig

# NEVER COMMIT A SIGNING KEY.
#
# Play re-signs every upload with the app signing key it holds, but the UPLOAD
# key is ours and losing control of it means somebody else can publish an
# update to this app. It is also not recoverable if lost — Play will let you
# rotate it, but only from an account that can still authenticate.
*.keystore
*.jks
*.p12
