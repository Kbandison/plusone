# Gradle's own output. Regenerated by `pnpm build`, and large.
build/
app/build/
.gradle/

# NEVER COMMIT A SIGNING KEY.
#
# Play re-signs every upload with the app signing key it holds, but the UPLOAD
# key is ours and losing control of it means somebody else can publish an
# update to this app. It is also not recoverable if lost — Play will let you
# rotate it, but only from an account that can still authenticate.
*.keystore
*.jks
*.p12
