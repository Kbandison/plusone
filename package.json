{
  "name": "plusone",
  "version": "0.1.0",
  "private": true,
  "description": "Plus One \u2014 a private, verified community for people with HSV and HIV.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:sql": "node scripts/check-migrations.mjs",
    "check:db": "node scripts/verify-schema.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css,sql}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css,sql}\""
  },
  "devDependencies": {
    "pg": "^8.23.0",
    "prettier": "3.9.6",
    "supabase": "^2.114.0",
    "turbo": "2.10.9",
    "typescript": "7.0.2"
  }
}
