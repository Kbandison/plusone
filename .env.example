# Plus One — environment template.
#
# Copy to .env.local for development. Real values go in the Vercel dashboard,
# never in a committed file. The schema in packages/config/src/env.ts parses
# these at boot, so a missing or malformed key fails the deploy rather than
# surfacing as a null at 2am.
#
# Anything WITHOUT the NEXT_PUBLIC_ prefix must never reach the client bundle.

# ── Supabase ──────────────────────────────────────────────────────────────────
# A NEW, dedicated project (Decision #4). Zero shared infrastructure with any
# other product — PII and health-data isolation is non-negotiable.
# Note the key style: legacy anon/service_role keys are rejected by the schema.
# The Project URL — NOT the "RESTful endpoint" shown beside it in the API
# settings, which carries a /rest/v1 path. The schema rejects a path.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# SERVER ONLY. Bypasses RLS entirely — cron jobs, the Stripe webhook, and the
# purge job are the only legitimate callers.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx
#
# The Postgres connection string, and the one key here the APP never reads.
# Nothing in apps/web touches it and it is not set in Vercel — it exists for the
# scripts that talk to the database directly: `pnpm check:db`, the other
# `check:*` verifiers, and `pnpm seed` / `pnpm seed:remove`. All of them SKIP
# rather than fail when it is unset, which is what keeps CI green without ever
# handing a database credential to a runner.
#
# Copy it from the Supabase dashboard — Connect, or Project Settings → Database
# → Connection string → URI, and TAKE THE SESSION POOLER. Not the transaction
# pooler on 6543: it drops prepared statements and session state, and these
# scripts hold one `pg.Client` open across a whole run.
#
# The direct connection the dashboard offers first is the one that does NOT
# work. `db.<ref>.supabase.co` publishes an AAAA record and no A record at all,
# so any machine with no IPv6 route fails to reach it — ENETUNREACH on WSL,
# ENOTFOUND on macOS, same cause. WSL2 has no global IPv6 address by default;
# neither, as it turns out, does the network the Mac is on. (An earlier note
# here said the direct string ran every `check:*` on the Mac. It does not: the
# Mac was tried on 2026-08-25 and failed identically, which is how the pooler
# host below was found.)
#
# The session pooler answers on IPv4 and works from both machines, which is what
# makes it the right value for a file two of them share. Note the username
# changes with it: `postgres.<project-ref>`, not bare `postgres`.
#
# It carries the database password in the clear, which is why it lives in a
# shell or in .env.local and in no committed file.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:xxxxxxxxxxxx@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── URLs ──────────────────────────────────────────────────────────────────────
# BOTH are www, and both are the same value. Decided 2026-08-25 after the split
# cost four separate things in one day.
#
# The apex answers 308 to www, so it is not where the app is — it is a redirect
# to where the app is. That is merely a wasted hop in a browser and an outright
# failure in three other places: Capacitor hands any navigation outside
# server.url's host to the SYSTEM browser, so the shell ejected a member into
# Safari mid sign-in; Chrome does not follow redirects when it fetches
# assetlinks.json, so a TWA pointed at the apex keeps its address bar forever;
# and app.loveplusone.app was never attached to the project at all, so it
# answered 404 — which is what every link at the foot of a notification email
# pointed at, and what Stripe returned a subscriber to after checkout.
#
# If the apex is ever made canonical instead, it has to SERVE rather than
# redirect, and the iOS shell's server.url has to move with it.
NEXT_PUBLIC_SITE_URL=https://www.loveplusone.app
NEXT_PUBLIC_APP_URL=https://www.loveplusone.app

# ── Stripe (Decision #22) ─────────────────────────────────────────────────────
# $19.99 / 1mo · $39.99 / 3mo (highlighted default) · $69.99 / 6mo.
# Legal names live in Stripe only and are never mirrored into the app DB.
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_1MO=price_xxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_3MO=price_xxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_6MO=price_xxxxxxxxxxxx

# ── Resend ────────────────────────────────────────────────────────────────────
# Transactional only. Every subject is content-blind (§8).
RESEND_API_KEY=re_xxxxxxxxxxxx
# The verified sender, and the switch that turns email notifications on: unset,
# the notifier is not built and push is the only transport. The domain must be
# verified in Resend first — Resend refuses anything else, and it would refuse
# it per message rather than at boot.
# Bare address or `Name <addr@domain>`.
RESEND_FROM=change-me@example.com

# ── APNs (the iOS shell) ──────────────────────────────────────────────────────
# All four or none. A WebView has no PushManager, so this replaces web push
# inside Capacitor rather than adding to it — see apps/web/src/lib/apns.ts.
# Unset, the provider is never built and the shell is simply silent.
#
# From the Apple Developer account: Keys → a Key with APNs enabled. The .p8
# downloads once and cannot be retrieved again.
#   APNS_KEY_ID       the key's 10-character id
#   APNS_TEAM_ID      the team's 10-character id, top right of the portal
#   APNS_BUNDLE_ID    the app id, and the apns-topic header — app.loveplusone
#   APNS_PRIVATE_KEY  the .p8 contents, newlines and all
#
# APNS_ENVIRONMENT picks the HOST, and it is not a flag on one: a token minted
# by a development build is meaningless to production and answers 400
# BadDeviceToken, which is the most common way this looks broken when it is not.
# `sandbox` while testing on a device from Xcode; `production` for TestFlight
# and the App Store.
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=app.loveplusone
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxxxxx\n-----END PRIVATE KEY-----"
APNS_ENVIRONMENT=production

# ── Phone OTP (§7.2) ──────────────────────────────────────────────────────────
# One of: stub | supabase_twilio_verify | supabase_twilio
# `stub` refuses to construct in production.
#
#   supabase_twilio_verify — Twilio Verify. Sends over Twilio's OWN registered
#     infrastructure, so no A2P brand or campaign registration is needed and it
#     works the day you configure it. $0.05 a verification, nothing fixed.
#     Credentials: Account SID, Auth Token, Verify Service SID.
#
#   supabase_twilio — plain Programmable Messaging over a 10DLC number you rent
#     and register. ~$0.0125 a message, but needs carrier approval first and
#     carries ~$3/month fixed. Cheaper only above ~84 verifications a month.
#     Credentials: Account SID, Auth Token, Message Service SID.
#
# All of those live in the SUPABASE dashboard, not here — Supabase Auth talks to
# Twilio on our behalf, and the app cannot tell the two apart. This only records
# which is live, so the stub guard can refuse when a real one is.
#
# While this is `stub`, /dev/sign-in exists: it mints a real session for a
# phone-confirmed test member without sending an SMS, so the app can be used
# before a provider is live. It refuses to run in production and refuses
# whenever a real provider is set — both, independently.
OTP_PROVIDER=stub

# ── Liveness (Decision #21) ───────────────────────────────────────────────────
# Swappable adapter. One of: stub | aws_rekognition | facetec
# `stub` needs no credentials and refuses to construct in production.
#
# stripe_identity was a §4.2 candidate and is ruled out: Stripe Identity has no
# selfie-only mode — its selfie check matches a face against an uploaded ID
# document, which is identity verification, not liveness.
LIVENESS_PROVIDER=stub

# Required only when LIVENESS_PROVIDER=aws_rekognition, and then all three.
# Face Liveness is not available in every region — check before choosing one.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=xxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxx

# ── Local tunnel (development only) ───────────────────────────────────────────
# The bare host of a dev tunnel, no scheme: e.g. abc-123.trycloudflare.com
#
# Only needed to open the app on a phone — the liveness step needs a camera and
# a secure context, and a LAN address over http is neither. Next refuses Server
# Actions whose Origin does not match the host, so the tunnel host is named here.
# Ignored entirely when NODE_ENV=production.
DEV_TUNNEL_HOST=

# ── Web push (§8) ─────────────────────────────────────────────────────────────
# Generate a pair with:  npx web-push generate-vapid-keys
#
# All three are OPTIONAL. Push is the one channel that can be absent without the
# app being broken: every screen still works, members simply are not told the
# Drop landed. Set none of them and the permission control says notifications
# are unavailable rather than offering a button that cannot work.
#
# Set them and all three are needed — a private key with no subject signs a
# token no push service accepts, and that failure arrives one member at a time.
#
# The public half is handed to the browser at subscribe time, which is why it is
# NEXT_PUBLIC_. It is an identifier, not a secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who a push service should contact about us. A mailto: or https: URL that
# somebody reads — the same inbox as the privacy contact, most likely.
VAPID_SUBJECT=

# ── Cron ──────────────────────────────────────────────────────────────────────
# Shared secret so only Vercel Cron can invoke /api/cron/*. Minimum 32 chars.
CRON_SECRET=generate_a_long_random_string_at_least_32_chars
