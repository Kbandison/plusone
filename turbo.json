{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_APP_URL"
      ],
      /**
       * `.next/dev` must be excluded, or the cache stores the dev server.
       *
       * Next 16 moved `next dev` output out of `.next` and into `.next/dev` so
       * dev and build can run at the same time, and Turbopack's dev filesystem
       * cache — `turbopackFileSystemCacheForDev`, on by default — sits under
       * `.next/dev/cache`. Together that is ~1.6 GB of dev-server scratch that
       * has nothing to do with a build.
       *
       * `.next/**` swept all of it in. Every cached build came out at ~1 GB, of
       * which 37 MB was the actual output; the rest was whatever `next dev` had
       * left on disk. 1,595 entries later `.turbo/cache` was 186 GB, the WSL2
       * disk image had grown past 300 GB, and the VM was being killed partway
       * through writing one of them.
       *
       * Excluded, an artifact is the `server/` and `static/` that `next start`
       * actually needs. `.next/cache` is the build-side Turbopack cache and is
       * excluded for the same reason it always was.
       */
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    /**
     * No `outputs`, because nothing here produces any.
     *
     * This declared `coverage/**` and no vitest config asks for coverage, so
     * every run printed "no output files found for task X#test — please check
     * your outputs key" once per package. Four warnings a run, all of them
     * correct and none of them actionable, which is the shape of warning that
     * teaches people to stop reading warnings.
     *
     * A task with no outputs still caches. Turbo hashes the inputs and replays
     * the logs on a hit; what `outputs` adds is restoring files afterwards, and
     * a test run leaves none behind. Declare it again if coverage is ever
     * turned on — CONTRIBUTING says there is no coverage target and nothing
     * measures it.
     */
    "test": {}
  }
}
